+        if not _HISTORY_ERROR_LOGGED[0]:
+            _HISTORY_ERROR_LOGGED[0] = True
+            print(f"[ATTENTION] state history unreadable ({type(e).__name__}: {e}); not busy")
+        return float("inf")
+    return float("inf")  # in PROCESSING with no record of entering it
