+def _speech(seconds):
+    n = int(16000 * seconds)
+    pcm = (0.3 * np.sin(2 * np.pi * 180 * np.arange(n) / 16000) * 32767).astype("<i2")
+    return [pcm[i : i + 640].tobytes() for i in range(0, n, 640)]
